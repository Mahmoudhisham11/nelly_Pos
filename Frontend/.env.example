# Firebase: انظر .env.local.example (لا توجد قيم افتراضية عمدا)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Local server
# NELLY_DB_PATH=D:\\NellyData\\nelly.db
# SECRET_KEY=

# --- AI assistant (server only; set these on Vercel, never in the app) ---
# ANTHROPIC_API_KEY=
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}   (single-line JSON of the service account key)
# AI_MODEL=claude-haiku-5-5      # default claude-opus-5-5; Haiku 5.5 is ~40x cheaper and enough for data Q&A
# AI_DAILY_CALLS=150             # model calls per shop per day (one question = 2-4 calls)
# AI_EFFORT=low
# AI_ALLOWED_ORIGINS=https://your-site.vercel.app
# Desktop app (static build): the hosted site the assistant calls
# NEXT_PUBLIC_AI_URL=https://your-site.vercel.app
