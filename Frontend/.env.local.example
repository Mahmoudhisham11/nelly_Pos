# انسخ هذا الملف باسم .env.local داخل فولدر Frontend واملأه من إعدادات مشروع Firebase التجريبي
# (Project settings > General > Your apps > Web app > Config). لا تستخدم مشروع العميل الحقيقي للتجارب.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# AI assistant via OpenRouter (key from https://openrouter.ai/keys). Used by /api/ai (web) and by the desktop app.
OPENROUTER_API_KEY=
AI_MODEL=openrouter/free
